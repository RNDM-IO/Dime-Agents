# For your own bots and the MCP server. The terminal keeps its keys in ~/.dime-terminal/config.json instead.
DIME_API=https://api-dime.rndm.io
DIME_ACCOUNT=0xYourWallet
DIME_API_KEY=
# A file holding the session private key (never the wallet's key)
DIME_SESSION_KEY_FILE=
DIME_MCP_MAX_MARGIN_USD=1
DIME_MCP_MAX_LEVERAGE=1000
